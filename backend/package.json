{
  "name": "terk-ewallet-api",
  "version": "1.0.0",
  "description": "Express + TypeScript + MongoDB wallet API backed by Paystack (funding via Charge, payouts via Transfer).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:build": "tsc --watch",
    "dev": "node --watch dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "mongoose": "^8.24.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4"
  }
}
