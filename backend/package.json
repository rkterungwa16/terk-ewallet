{
  "name": "terk-ewallet-api",
  "version": "1.0.0",
  "description": "Express + TypeScript + MongoDB wallet API backed by Paystack (funding via Charge, payouts via Transfer).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev:build": "tsc --watch",
    "dev": "node --watch --env-file=.env dist/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10"
  }
}
