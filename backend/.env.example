# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/paystack_wallet

# Auth tokens (used to hand-sign JWTs with HMAC-SHA256, see src/utils/jwt.ts)
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN_MINUTES=60

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Paystack should redirect the customer's browser after a checkout
# (only relevant if you use the hosted-page fund flow instead of pop-up/inline)
PAYSTACK_CALLBACK_URL=http://localhost:4000/v1/wallet/fund/callback
