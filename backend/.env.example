# Server
PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated, e.g. your deployed
# frontend URL). Any localhost/127.0.0.1 port is also allowed outside production.
CORS_ORIGINS=http://localhost:5173

# MongoDB. Use a replica set in production (MongoDB Atlas always is one):
# transfers, withdrawals and deposits then commit atomically. A standalone
# server works, but logs a warning at startup and moves money step by step.
MONGO_URI=mongodb://127.0.0.1:27017/paystack_wallet

# Auth tokens (used to hand-sign JWTs with HMAC-SHA256, see src/utils/jwt.ts)
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN_MINUTES=60

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How long to wait for a Paystack API call before failing it (milliseconds)
PAYSTACK_TIMEOUT_MS=10000

# Withdrawals whose transfer request timed out stay pending until Paystack
# tells us how they ended. Every RECONCILE_INTERVAL_MS the server asks Paystack
# about any withdrawal pending longer than RECONCILE_MIN_AGE_MS and settles it
# (refunding if Paystack failed it or never received it). 0 disables the check.
RECONCILE_INTERVAL_MS=300000
RECONCILE_MIN_AGE_MS=900000

# HTTP server. Keep KEEP_ALIVE_TIMEOUT_MS above your proxy's idle timeout
# (usually 60s). SHUTDOWN_TIMEOUT_MS is how long in-flight requests get to
# finish on SIGTERM before the process exits anyway.
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_TIMEOUT_MS=10000

# Number of reverse proxies in front of the app, so per-IP rate limits see
# the real client IP from X-Forwarded-For. Set to 1 behind Railway's edge.
# Leave at 0 locally. Setting it higher than the real hop count lets clients
# forge their IP.
TRUST_PROXY=0
# Auth rate limits: requests per client IP per minute on /v1/auth/*, and
# failed logins per email address per 15 minutes
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_FAILURES_PER_15_MIN=10

# Where Paystack should redirect the customer's browser after a checkout
# (only relevant if you use the hosted-page fund flow instead of pop-up/inline)
PAYSTACK_CALLBACK_URL=http://localhost:4000/v1/wallet/fund/callback
